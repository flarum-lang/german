{
	"name": "flarum-lang/german",
	"description": "German Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/german",
	"license": "MIT",
	"authors": [
		{
			"name": "Kakifrucht",
			"homepage": "https://github.com/Kakifrucht",
			"role": "Maintainer"
		},
		{
			"name": "claudiush",
			"homepage": "https://github.com/claudiush",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/flarum-lang/german/issues",
		"forum": "https://discuss.flarum.org/d/2648",
		"source": "https://github.com/flarum-lang/german"
	},
	"require": {
		"flarum/core": "^2.0",
		"flarum-lang/utils": "^2.0"
	},
	"extra": {
		"flarum-extension": {
			"title": "German",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundColor": "#ffffff",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
